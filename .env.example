# ==============================================================================
# Butuan City Vendors Registration System - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. For local development, copy this file to .env.local and replace with your keys.
# 2. For Vercel deployment, add these key-value pairs in:
#    Project Settings -> Environment Variables.

# --- Clerk Authentication Routes ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth-redirect
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth-redirect

# --- Clerk API Keys ---
# Retrieve from https://dashboard.clerk.com -> Select your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# --- Supabase Database Configuration ---
# Retrieve from https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVER_AUTH_SECRET=your_supabase_server_secret_here
